generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum MessageStatus {
  NEW
  READ
  ARCHIVED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     AuthSession[]
}

model AuthSession {
  id               String   @id @default(uuid())
  userId           String
  accessTokenHash  String
  refreshTokenHash String
  rememberMe       Boolean  @default(false)
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Service {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  summary     String   @db.Text
  points      Json?
  description String?  @db.Text
  icon        String?
  isFeatured  Boolean  @default(false)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  category    String   @default("General")
  client      String?
  location    String?
  year        Int?
  summary     String   @db.Text
  description String?  @db.Text
  imageUrl    String?
  imagePublicId String?
  gallery     Json?
  isFeatured  Boolean  @default(false)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Client {
  id           String   @id @default(uuid())
  name         String
  logoUrl      String?
  logoPublicId String?
  website      String?
  isFeatured   Boolean  @default(false)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model HeroSlide {
  id                  String   @id @default(uuid())
  badgeText           String
  title               String
  subtitle            String   @db.Text
  imageUrl            String
  primaryButtonText   String?
  primaryButtonLink   String?
  secondaryButtonText String?
  secondaryButtonLink String?
  sortOrder           Int      @default(0)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ContactMessage {
  id            String        @id @default(uuid())
  name          String
  email         String
  phone         String?
  subject       String?
  message       String        @db.Text
  status        MessageStatus @default(NEW)
  repliedAt     DateTime?
  replyMessage  String?       @db.Text
  repliedBy     String?
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model SiteSettings {
  id                 String   @id @default("main")
  logoUrl            String?
  logoPublicId       String?
  faviconUrl         String?
  faviconPublicId    String?
  officeAddressLine1 String?
  officeAddressLine2 String?
  mapLocation        String?
  mapLocationText    String?
  contactEmails      Json?
  contactPhones      Json?
  branches           Json?
  socialLinks        Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model WhatWeDoItem {
  id        String   @id @default(uuid())
  title     String
  summary   String   @db.Text
  iconKey   String   @default("Anchor")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JourneyMilestone {
  id        String   @id @default(uuid())
  year      String
  title     String
  desc      String   @db.Text
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OurStoryCard {
  id        String   @id @default("main")
  sinceLabel String  @default("Since 2014")
  headingLine1 String @default("Built by the sea,") @db.Text
  headingLine2 String @default("for the sea.") @db.Text
  storyHtml String   @default("<p>Maritime Solutions was founded by a small group of naval architects and former captains who shared a singular realization: the industry was changing faster than the engineering firms could adapt.</p><p>We started in a small office near the Port of Singapore with nothing but a set of blueprints and a commitment to radical transparency. We didn't want to be another generic corporate consultancy; we wanted to be technical partners who understood the vibration of the engine and the weight of the cargo.</p><p>Today, we have grown into a global presence, yet our purpose remains unchanged: providing the engineering backbone for those who navigate the world's most vital waterways.</p>") @db.Text
  badge     String   @default("Global Impact")
  title     String
  imageUrl  String
  imagePublicId String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
