generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum MessageStatus {
  NEW
  READ
  ARCHIVED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     AuthSession[]
  passwordResetTokens PasswordResetToken[]
}

model AuthSession {
  id               String   @id @default(uuid())
  userId           String
  accessTokenHash  String
  refreshTokenHash String
  rememberMe       Boolean  @default(false)
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Service {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  summary     String   @db.Text
  points      Json?
  description String?  @db.Text
  icon        String?
  isFeatured  Boolean  @default(false)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  category    String   @default("General")
  client      String?
  location    String?
  year        Int?
  summary     String   @db.Text
  description String?  @db.Text
  imageUrl    String?
  imagePublicId String?
  gallery     Json?
  isFeatured  Boolean  @default(false)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Client {
  id           String   @id @default(uuid())
  name         String
  logoUrl      String?
  logoPublicId String?
  website      String?
  isFeatured   Boolean  @default(false)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ClientSector {
  id          String   @id @default(uuid())
  title       String
  body        String   @db.Text
  points      Json?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HeroSlide {
  id                  String   @id @default(uuid())
  badgeText           String
  title               String
  subtitle            String   @db.Text
  imageUrl            String
  primaryButtonText   String?
  primaryButtonLink   String?
  secondaryButtonText String?
  secondaryButtonLink String?
  sortOrder           Int      @default(0)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model FaqItem {
  id        String   @id @default(uuid())
  category  String
  question  String   @db.Text
  answer    String   @db.Text
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeliveryApproachSection {
  id        String   @id @default("main")
  eyebrow   String   @default("Our Delivery Approach")
  title     String   @default("Accurate. Actionable. Sustainable.")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeliveryApproachStep {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  iconKey     String   @default("Search")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactMessage {
  id            String        @id @default(uuid())
  name          String
  email         String
  phone         String?
  subject       String?
  message       String        @db.Text
  status        MessageStatus @default(NEW)
  repliedAt     DateTime?
  replyMessage  String?       @db.Text
  repliedBy     String?
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model SiteSettings {
  id                 String   @id @default("main")
  logoUrl            String?
  logoPublicId       String?
  darkLogoUrl        String?
  darkLogoPublicId   String?
  navbarBrandText    String?
  navbarBrandAccent  String?
  navbarBrandSubtext String?
  footerBrandText    String?  @db.Text
  faviconUrl         String?
  faviconPublicId    String?
  officeAddressLine1 String?
  officeAddressLine2 String?
  mapLocation        String?
  mapLocationText    String?
  whatsappNumber     String?
  companyProfileUrl  String?  @db.Text
  companyProfilePublicId String?
  contactEmails      Json?
  contactPhones      Json?
  branches           Json?
  socialLinks        Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model WhatWeDoItem {
  id        String   @id @default(uuid())
  title     String
  summary   String   @db.Text
  iconKey   String   @default("Anchor")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JourneyMilestone {
  id        String   @id @default(uuid())
  year      String
  title     String
  desc      String   @db.Text
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OurStoryCard {
  id        String   @id @default("main")
  sinceLabel String  @default("Since 2014")
  headingLine1 String @db.Text
  headingLine2 String @db.Text
  storyHtml String   @db.Text
  badge     String   @default("Global Impact")
  title     String
  imageUrl  String
  imagePublicId String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
